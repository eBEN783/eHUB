rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'balance']) &&
        data.keys().hasOnly([
          'userId', 'email', 'displayName', 'balance',
          'referralCode', 'referredBy', 'referralEarnings', 'referralCount', 'referredUsers',
          'biometricEnabled', 'biometricCredentialId',
          'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        data.balance is number && data.balance >= 0 &&
        (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 64)) &&
        (!('referredBy' in data) || (data.referredBy is string && data.referredBy.size() <= 64)) &&
        (!('referralEarnings' in data) || (data.referralEarnings is number && data.referralEarnings >= 0)) &&
        (!('referralCount' in data) || (data.referralCount is number && data.referralCount >= 0)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['transactionId', 'userId', 'type', 'amount', 'status']) &&
        data.keys().hasOnly(['transactionId', 'userId', 'type', 'title', 'amount', 'status', 'reference', 'details', 'createdAt', 'token']) &&
        data.transactionId is string && data.transactionId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.type in ['data', 'airtime', 'electricity', 'cable', 'funding'] &&
        (!('title' in data) || (data.title is string && data.title.size() <= 128)) &&
        data.amount is number && data.amount > 0 &&
        data.status in ['successful', 'pending', 'failed'] &&
        (!('reference' in data) || (data.reference is string && data.reference.size() <= 128)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
        (!('token' in data) || (data.token is string && data.token.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // User profile and wallet
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;

      // Transactions sub-collection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
